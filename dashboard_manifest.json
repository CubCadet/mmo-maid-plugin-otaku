{
  "pages": [
    {
      "id": "overview",
      "title": "Overview",
      "widgets": [
        {
          "type": "stat_card",
          "id": "total_events",
          "label": "Total Events",
          "rpc_method": "get_stat",
          "rpc_params": {"stat": "total_events"},
          "width": "quarter"
        },
        {
          "type": "chart",
          "id": "events_chart",
          "title": "Events Over Time",
          "chart_type": "line",
          "rpc_method": "get_timeseries",
          "rpc_params": {"metric": "events", "period": "7d"},
          "width": "full"
        },
        {
          "type": "table",
          "id": "recent",
          "title": "Recent Activity",
          "rpc_method": "get_table",
          "rpc_params": {"limit": 20},
          "columns": [
            {"key": "time", "label": "Time"},
            {"key": "user", "label": "User"},
            {"key": "action", "label": "Action"}
          ],
          "width": "full"
        }
      ]
    },
    {
      "id": "settings",
      "title": "Settings",
      "widgets": [
        {
          "type": "form",
          "id": "config",
          "title": "Plugin Settings",
          "rpc_method": "get_settings",
          "save_rpc_method": "save_settings",
          "fields": [
            {"key": "prefix", "label": "Command Prefix", "type": "text"},
            {"key": "enabled", "label": "Enabled", "type": "toggle"}
          ],
          "width": "full"
        }
      ]
    }
  ]
}
